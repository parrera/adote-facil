{
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name",
    "migrate:rollback": "prisma migrate reset --force --skip-seed",
    "migrate:prod": "prisma migrate deploy",
    "dev": "tsx watch src/server.ts",
    "build": "swc src --out-dir dist --strip-leading-paths",
    "start": "npm run migrate:prod && node dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write --list-different",
    "precommit": "pretty-quick --staged"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.23",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.8",
    "prisma": "^6.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^15.5.0"
  }
}
